# Supabase Session Pooler URI (Project Settings > Database > Connection string > Session pooler)
DATABASE_URL=

# REQUIRED in production: random string, at least 32 characters (e.g. `openssl rand -base64 48`).
# Signs the session cookie. The app refuses to start sessions in production without it.
AUTH_SECRET=

# Optional: PEM contents of the Supabase CA certificate to fully verify the database TLS chain.
DATABASE_CA_CERT=

# Optional: max connections per server instance (default 3; keep small on Vercel).
DATABASE_POOL_MAX=

NEXT_PUBLIC_APP_URL=http://localhost:3000
