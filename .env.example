# Supabase Cloud PostgreSQL Connection URI (Required)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secret used to sign HTTP-only session cookies (defaults to dev secret locally if omitted)
AUTH_SECRET=pse-dashboard-dev-secret-change-in-production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
